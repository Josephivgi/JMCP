{
  "name": "jmcp",
  "version": "0.1.5",
  "private": true,
  "license": "MIT",
  "author": "Josephivgi",
  "description": "JMCP: see and manage the MCP servers of every coding agent on your computer, and install JMCP servers (starting with cross-provider subagents) into all of them at once.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Josephivgi/JMCP.git"
  },
  "main": "app/main.cjs",
  "bin": {
    "jmcp": "cli/jmcp.cjs"
  },
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "test": "node --test --test-concurrency=1 test/*.test.cjs",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.4.2"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.josephivgi.jmcp",
    "productName": "JMCP",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "files": [
      "app/**",
      "core/**",
      "cli/**",
      "servers/**",
      "package.json",
      "!**/test/**",
      "!**/*.jmcp-tmp",
      "!servers/subagents/node_modules/!(@anthropic-ai|ajv|ajv-formats|fast-deep-equal|fast-uri|json-schema-traverse|require-from-string)/**",
      "!servers/subagents/node_modules/@anthropic-ai/!(claude-agent-sdk|claude-agent-sdk-win32-x64|claude-agent-sdk-win32-arm64)/**",
      "!**/node_modules/**/*.{map,ts,mts,cts,md,markdown}"
    ],
    "win": {
      "target": "nsis",
      "icon": "app/assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "JMCP-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Josephivgi",
        "repo": "JMCP",
        "releaseType": "draft"
      }
    ]
  }
}
